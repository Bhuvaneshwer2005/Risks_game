{
  // Lets Node's tsc type-check the Edge Function (npx tsc -p supabase/functions).
  // Deno itself ignores this file.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "npm:@supabase/supabase-js@2": ["../../node_modules/@supabase/supabase-js"],
      "jsr:@supabase/functions-js/edge-runtime.d.ts": ["./deno-shim.d.ts"]
    }
  },
  "include": ["game/**/*.ts", "deno-shim.d.ts"]
}
